# font-family = SF Mono
font-family = Ioskeley Mono Term
# font-family = IBM Plex Mono
# font-family = Mx437 DOS/V re. ANK30
# font-family = gallant12x22
# font-family = Mx437 Cordata PPC-400
# font-family = Mx437 IBM VGA 8x16
# font-family = CommitMono
font-style-italic = false
font-style-bold = false
font-feature = -calt, -liga, -dlig
# font-size = 22
font-size = 16
theme = dark: iTerm2 Tango Dark, light: iTerm2 Tango Light
font-thicken = true
font-thicken-strength = 0
cursor-style-blink = false
mouse-hide-while-typing = true
window-colorspace = display-p3
resize-overlay = never
confirm-close-surface = false
shell-integration-features = no-cursor
macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
window-padding-color = extend
progress-style = false
