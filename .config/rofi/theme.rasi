@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 400px;
    location: north;
    anchor: north;
    y-offset: 30%;
    background-color: transparent;
}

mainbox {
    background-color: transparent;
    spacing: 8px;
    children: [ inputbar, message, listview ];
}

inputbar {
    children: [ entry ];
    padding: 12px 16px;
    background-color: @bg;
    border-radius: 20px;
    border: 2px;
    border-color: @fg-dim;
}

message {
    padding: 12px 16px;
    background-color: @bg;
    border-radius: 20px;
    border: 2px;
    border-color: @fg-dim;
}

listview {
    require-input: true;
    lines: 8;
    padding: 8px 0px 8px 8px;
    spacing: 0px;
    background-color: @bg;
    border-radius: 20px;
    border: 2px;
    border-color: @fg-dim;
    scrollbar: true;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @fg-dim;
    border-radius: 4px;
    margin: 16px 4px;
}

element {
    spacing: 12px;
    padding: 8px 12px;
    border-radius: 16px;
}

element-text {
    text-color: inherit;
}

element selected.normal {
    background-color: @fg;
    text-color: @bg;
}

